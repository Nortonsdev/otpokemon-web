{
  "name": "otpokemon-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser Pokémon MMORPG milestone: Huntera tiles + human look, Ruby sprites, server-authoritative",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "concurrently -k -n server,client -c blue,green \"npm:start:server\" \"npm:start:client\"",
    "start:server": "node --import tsx server/index.js",
    "start:client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && node tools/bundle-api.mjs",
    "bundle:api": "node tools/bundle-api.mjs",
    "test": "node --import tsx tools/test-otbm.mjs",
    "test:smoke": "node tools/smoketest.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "three": "^0.170.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.0.7",
    "esbuild": "^0.25.9"
  }
}
